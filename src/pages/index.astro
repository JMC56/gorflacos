---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import HeroSlider from '../components/HeroSlider.astro';
import CollectionRail from '../components/CollectionRail.astro';
import CartDrawer from '../components/CartDrawer.astro';
import CheckoutModal from '../components/CheckoutModal.astro';
import TrackingBar from '../components/TrackingBar.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <TrackingBar />
  <div id="order-success" class="mx-auto hidden max-w-7xl px-5 pt-5 lg:px-8"><div class="rounded-2xl bg-mint px-5 py-4 text-center font-bold text-leaf">Tu pedido ya fue registrado. El equipo lo revisará y actualizará su estado desde aquí.</div></div>
  <Header />
  <main>
    <HeroSlider />
    <CollectionRail />
    <section id="story" class="scroll-reveal bg-bubblegum/35 px-5 py-20 lg:px-8 lg:py-28"><div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[0.7fr_1.3fr] lg:items-center"><p class="font-display text-7xl font-bold leading-none tracking-[-0.1em] text-candy sm:text-9xl">GOR<br /><span class="text-ink">FLACOS</span></p><div class="max-w-2xl"><p class="text-xs font-bold tracking-[0.24em] text-leaf">NUESTRA HISTORIA</p><h2 class="mt-4 font-display text-4xl font-bold tracking-[-0.06em] sm:text-6xl">Golosinas con personalidad propia.</h2><p class="mt-6 text-lg leading-8 text-ink/65">Gorflacos existe para convertir un día cualquiera en una pausa de colores, sabores y algo que sí vale la pena compartir.</p></div></div></section>
  </main>
  <Footer />
  <CartDrawer />
  <CheckoutModal />
</BaseLayout>

<script src="../scripts/store.ts"></script>
<script>
  if (new URLSearchParams(window.location.search).get('pedido') === 'registrado') document.querySelector('#order-success')?.classList.remove('hidden');
</script>