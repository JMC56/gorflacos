---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ProductGrid from '../components/ProductGrid.astro';
import CartDrawer from '../components/CartDrawer.astro';
import CheckoutModal from '../components/CheckoutModal.astro';
import TrackingBar from '../components/TrackingBar.astro';
import Footer from '../components/Footer.astro';
const category = Astro.url.searchParams.get('category') || 'Shop All';
const search = Astro.url.searchParams.get('search') || '';
const categories = ['Shop All', 'Best Sellers', 'Party Packs', 'Sweet & Sour', 'Chocolates'];
---
<BaseLayout title="Shop All | Gorflacos"><TrackingBar /><Header /><main class="mx-auto max-w-7xl px-5 py-12 lg:px-8 lg:py-20"><div class="max-w-2xl"><p class="text-xs font-bold tracking-[0.24em] text-candy">FIND YOUR HAPPY</p><h1 id="shop-title" class="mt-3 font-display text-5xl font-bold tracking-[-0.08em] sm:text-7xl">Shop all the sweet stuff.</h1><p class="mt-5 text-lg leading-8 text-ink/65">Filtra por colección y encuentra la mezcla que te está llamando.</p></div><div class="mt-10 flex flex-wrap gap-2">{categories.map((item) => <a data-shop-category={item} class={`rounded-full border border-ink/15 px-4 py-2 text-sm font-bold transition hover:bg-ink hover:text-white ${category === item ? 'bg-ink text-white' : ''}`} href={item === 'Shop All' ? '/shop' : `/shop?category=${encodeURIComponent(item)}`}>{item}</a>)}</div><div class="mt-10"><ProductGrid category={category} search={search} emptyMessage="Aún no hay golosinas en esta colección." /></div></main><Footer /><CartDrawer /><CheckoutModal /></BaseLayout><script src="../scripts/store.ts"></script><script>
	const selectedCategory = new URLSearchParams(window.location.search).get('category') || 'Shop All';
	document.querySelectorAll('[data-shop-category]').forEach((link) => { if (link instanceof HTMLElement) link.classList.toggle('bg-ink', link.dataset.shopCategory === selectedCategory); });
	document.querySelectorAll('[data-shop-category]').forEach((link) => { if (link instanceof HTMLElement) link.classList.toggle('text-white', link.dataset.shopCategory === selectedCategory); });
	const title = document.querySelector('#shop-title');
	if (title && selectedCategory !== 'Shop All') title.textContent = selectedCategory;
</script>