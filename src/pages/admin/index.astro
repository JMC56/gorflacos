---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Admin | Gorflacos">
  <main class="min-h-screen px-5 py-8 lg:px-8"><div class="mx-auto max-w-7xl">
    <header class="flex flex-col justify-between gap-5 border-b border-ink/10 pb-8 sm:flex-row sm:items-center"><div><a class="inline-block" href="/"><img src="/assets/gorflacos-logo.png" alt="Gorflacos" width="200" height="60" class="h-12 w-auto" /></a><p class="mt-3 text-xs font-bold tracking-[0.2em] text-candy">PRODUCT COMMAND CENTER</p><h1 class="mt-2 font-display text-4xl font-bold tracking-[-0.07em]">Tu catálogo, sin hojas de cálculo.</h1></div><button id="admin-logout" class="candy-button" type="button">Salir</button></header>
    <section class="mt-10 grid gap-5 md:grid-cols-3"><div class="candy-panel p-6"><p class="text-xs font-bold tracking-[0.18em] text-ink/50">PRODUCTOS</p><p id="metric-products" class="mt-3 font-display text-4xl font-bold">0</p></div><div class="candy-panel p-6"><p class="text-xs font-bold tracking-[0.18em] text-ink/50">STOCK TOTAL</p><p id="metric-stock" class="mt-3 font-display text-4xl font-bold">0</p></div><div class="candy-panel p-6"><p class="text-xs font-bold tracking-[0.18em] text-ink/50">SOLICITUDES</p><p id="metric-requests" class="mt-3 font-display text-4xl font-bold">0</p></div></section>
    <section class="mt-10 grid gap-8 lg:grid-cols-[0.85fr_1.15fr]"><form id="product-form" class="candy-panel p-7"><input type="hidden" name="id" /><div class="flex items-center justify-between"><div><p class="text-xs font-bold tracking-[0.18em] text-candy">CATÁLOGO SUPABASE</p><h2 class="mt-2 font-display text-3xl font-bold">Producto</h2></div><button id="cancel-edit" class="hidden text-sm font-bold text-ink/50" type="button">Cancelar</button></div><div class="mt-6 grid gap-4 sm:grid-cols-2"><label class="block text-sm font-bold">Nombre<input required name="name" class="mt-2 w-full rounded-xl border border-ink/15 bg-white px-4 py-3" /></label><label class="block text-sm font-bold">Precio<input required min="0" step="0.01" type="number" name="price" class="mt-2 w-full rounded-xl border border-ink/15 bg-white px-4 py-3" /></label><label class="block text-sm font-bold">Categoría<select required name="category" class="mt-2 w-full rounded-xl border border-ink/15 bg-white px-4 py-3"><option>Best Sellers</option><option>Party Packs</option><option>Sweet & Sour</option><option>Chocolates</option></select></label><label class="block text-sm font-bold">SKU<input required name="sku" class="mt-2 w-full rounded-xl border border-ink/15 bg-white px-4 py-3" /></label><label class="block text-sm font-bold">Stock disponible<input required min="0" type="number" name="stock" class="mt-2 w-full rounded-xl border border-ink/15 bg-white px-4 py-3" /></label><label class="block text-sm font-bold">Imagen principal<input required name="image" accept="image/*" type="file" class="mt-2 block w-full rounded-xl border border-dashed border-ink/20 bg-white p-3 text-sm" /></label><label class="block text-sm font-bold">Imagen adicional 1 <span class="font-normal text-ink/50">(opcional)</span><input name="image2" accept="image/*" type="file" class="mt-2 block w-full rounded-xl border border-dashed border-ink/20 bg-white p-3 text-sm" /></label><label class="block text-sm font-bold">Imagen adicional 2 <span class="font-normal text-ink/50">(opcional)</span><input name="image3" accept="image/*" type="file" class="mt-2 block w-full rounded-xl border border-dashed border-ink/20 bg-white p-3 text-sm" /></label><label class="block text-sm font-bold sm:col-span-2">Descripción<textarea required name="description" rows="3" class="mt-2 w-full rounded-xl border border-ink/15 bg-white px-4 py-3"></textarea></label><label class="block text-sm font-bold sm:col-span-2">Detalles<textarea name="details" rows="3" class="mt-2 w-full rounded-xl border border-ink/15 bg-white px-4 py-3"></textarea></label><label class="flex items-center gap-3 text-sm font-bold"><input name="published" type="checkbox" checked class="size-4 accent-candy" /> Disponible en la tienda</label><button class="candy-button-pink sm:col-span-2 w-full" type="submit">Guardar producto</button><p id="admin-form-status" class="hidden rounded-xl p-3 text-sm sm:col-span-2"></p></div></form>
      <div class="candy-panel overflow-hidden p-7"><div class="flex items-end justify-between"><div><p class="text-xs font-bold tracking-[0.18em] text-candy">DATOS EN TIEMPO REAL</p><h2 class="mt-2 font-display text-3xl font-bold">Productos</h2></div><button id="refresh-products" class="text-2xl text-ink transition hover:scale-125" type="button" aria-label="Actualizar productos"><i class="fi fi-rr-refresh"></i></button></div><div id="admin-products" class="mt-6 divide-y divide-ink/10"></div><div id="admin-requests" class="mt-10"></div></div>
    </section>
    <section class="scroll-reveal mt-10 candy-panel p-7"><div><p class="text-xs font-bold tracking-[0.18em] text-candy">PEDIDOS DEL COLEGIO</p><h2 class="mt-2 font-display text-3xl font-bold">Solicitudes de compra</h2></div><div id="admin-orders" class="mt-6 space-y-4"></div></section>
  </div></main>
</BaseLayout>
<script src="../../scripts/admin-dashboard.ts"></script>
