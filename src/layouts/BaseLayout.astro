---
import '../styles/global.css';
import LaunchCountdown from '../components/LaunchCountdown.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Gorflacos | Snacks con carácter',
  description = 'Snacks, combos y antojos preparados para compartir.'
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn-uicons.flaticon.com/3.0.0/uicons-regular-rounded/css/uicons-regular-rounded.css" />
    <link rel="stylesheet" href="https://cdn-uicons.flaticon.com/3.0.0/uicons-brands/css/uicons-brands.css" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-cream font-body text-ink antialiased">
    <LaunchCountdown />
    <slot />
    <script>
      const currentUrl = new URL(window.location.href);
      if (currentUrl.searchParams.has('logout')) {
        document.cookie = 'gorflacos_admin=; max-age=0; path=/; SameSite=Lax';
        localStorage.removeItem('gorflacos-admin-last-active');
        currentUrl.searchParams.delete('logout');
        currentUrl.searchParams.set('admin', '');
        window.history.replaceState(null, '', `${currentUrl.pathname}?${currentUrl.searchParams.toString()}`);
      }

      if (currentUrl.searchParams.has('admin')) {
        document.querySelectorAll('a[href^="/"]').forEach((link) => {
          if (!(link instanceof HTMLAnchorElement)) return;
          const destination = new URL(link.href, window.location.origin);
          destination.searchParams.set('admin', '');
          link.href = `${destination.pathname}?${destination.searchParams.toString()}${destination.hash}`;
        });
      }

      const pagePath = window.location.pathname.replace(/\/+$/, '') || '/';
      if (pagePath === '/' || pagePath === '/privacy-policy' || pagePath === '/terms-of-service') {
        history.scrollRestoration = 'manual';
        window.scrollTo(0, 0);
        window.addEventListener('load', () => window.scrollTo(0, 0), { once: true });
      }

      const revealElements = new Set();
      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -48px' });

      function observeRevealElements() {
        document.querySelectorAll('.scroll-reveal:not(.is-visible)').forEach((element) => {
          if (!revealElements.has(element)) {
            revealElements.add(element);
            revealObserver.observe(element);
          }
        });
      }

      document.querySelectorAll('.legal-page header, .legal-content > * > *').forEach((element, index) => {
        element.classList.add('scroll-reveal', `scroll-reveal-delay-${(index % 3) + 1}`);
      });

      observeRevealElements();
      document.addEventListener('catalog:updated', observeRevealElements);
    </script>
  </body>
</html>