---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  updatedAt?: string;
}

const { title, description, updatedAt } = Astro.props;
---

<BaseLayout title={`${title} | Gorflacos`} description={description}>
  <Header />
  <main class="legal-page mx-auto min-h-[70vh] max-w-7xl px-5 py-16 lg:px-8 lg:py-24">
    <header class="mx-auto max-w-3xl text-center">
      <p class="text-xs font-bold uppercase tracking-[0.24em] text-tomato">Support</p>
      <h1 class="mt-3 font-display text-4xl font-bold leading-tight sm:text-6xl">{title}</h1>
      {updatedAt && <p class="mt-4 text-sm text-ink/55">Actualización: {updatedAt}</p>}
    </header>
    <article class="legal-content mx-auto mt-10 min-h-[30rem] max-w-5xl rounded-xl border border-ink/10 bg-white/85 p-6 sm:p-10 lg:p-14">
      <slot />
    </article>
  </main>
  <Footer />
</BaseLayout>