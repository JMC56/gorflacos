---
const instagramUrl = '';
const tiktokUrl = '';

const navigationLinks = [
	{ label: 'Tienda', href: '/shop' },
	{ label: 'Política de privacidad', href: '/privacy-policy' },
	{ label: 'Términos de servicio', href: '/terms-of-service' },
	{ label: 'FAQs', href: '/faqs' }
];

const categoryLinks = [
	{ label: 'Shop All', href: '/shop' },
	{ label: 'Sweet & Sour', href: '/shop?category=Sweet%20%26%20Sour' },
	{ label: 'Best Sellers', href: '/shop?category=Best%20Sellers' },
	{ label: 'Chocolates', href: '/shop?category=Chocolates' }
];
---

<footer id="blog" class="border-t border-candy/20 bg-[#fff0f5] px-5 py-14 text-ink lg:px-8">
	<div class="mx-auto grid max-w-7xl gap-12 sm:grid-cols-2 lg:grid-cols-[1.35fr_1fr_1fr_0.8fr] lg:gap-10">
		<div>
			<a class="inline-block" href="/" aria-label="Gorflacos inicio"><img src="/assets/gorflacos-logo.png" alt="Gorflacos" width="2170" height="725" class="h-12 w-auto" /></a>
			<p class="mt-7 text-xs font-bold uppercase tracking-[0.16em] text-ink/55">Contáctanos</p>
			<a class="mt-2 inline-block text-base font-bold transition hover:text-candy" href="mailto:support@gorflacos.xyz">support@gorflacos.xyz</a>
		</div>

		<nav aria-label="Navigation">
			<h2 class="font-display text-sm font-bold uppercase tracking-[0.18em]">Navigation</h2>
			<ul class="mt-5 space-y-3 text-sm text-ink/70">
				{navigationLinks.map((link) => <li><a class="transition hover:text-candy" href={link.href}>{link.label}</a></li>)}
			</ul>
		</nav>

		<nav aria-label="Categories">
			<h2 class="font-display text-sm font-bold uppercase tracking-[0.18em]">Categories</h2>
			<ul class="mt-5 space-y-3 text-sm text-ink/70">
				{categoryLinks.map((link) => <li><a class="transition hover:text-candy" href={link.href}>{link.label}</a></li>)}
			</ul>
		</nav>

		<div>
			<h2 class="font-display text-sm font-bold uppercase tracking-[0.18em]">Follow Us</h2>
			<div class="mt-5 flex items-center gap-5 text-2xl text-ink/70">
				{instagramUrl ? <a class="transition hover:text-candy" href={instagramUrl} target="_blank" rel="noreferrer" aria-label="Instagram"><i class="fi fi-brands-instagram"></i></a> : <span class="opacity-45" aria-label="Instagram, agregar URL en Footer.astro" title="Agrega la URL de Instagram en Footer.astro"><i class="fi fi-brands-instagram"></i></span>}
				{tiktokUrl ? <a class="transition hover:text-candy" href={tiktokUrl} target="_blank" rel="noreferrer" aria-label="TikTok"><i class="fi fi-brands-tiktok-circle"></i></a> : <span class="opacity-45" aria-label="TikTok, agregar URL en Footer.astro" title="Agrega la URL de TikTok en Footer.astro"><i class="fi fi-brands-tiktok-circle"></i></span>}
			</div>
		</div>
	</div>
	<div class="mx-auto mt-12 max-w-7xl border-t border-candy/20 pt-5 text-xs text-ink/50">© {new Date().getFullYear()} Gorflacos</div>
</footer>