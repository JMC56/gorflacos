---
const banners = [
  { image: '/assets/gorflacos1.png', eyebrow: '', title: '', cta: '', href: '/shop' },
  { image: '/assets/gorflacos2.png', eyebrow: '', title: '', cta: '', href: '/shop?category=Party%20Packs' },
  { image: '/assets/gorflacos3.png', eyebrow: '', title: '', cta: '', href: '/shop?category=Best%20Sellers' }
];
---
<section class="scroll-reveal mx-auto max-w-7xl px-5 pt-5 lg:px-8 lg:pt-8" aria-label="Promociones destacadas">
  <div id="hero-slider" class="relative overflow-hidden rounded-[2rem] shadow-candy">
    <div id="hero-track" class="flex transition-transform duration-700 ease-out">
    {banners.map((banner) => <article class="hero-slide relative min-w-full" data-slide>
      <img class="aspect-[3/1] w-full object-cover" src={banner.image} alt={banner.title} width="1200" height="400" />
    </article>)}
    </div>
    <div class="absolute bottom-5 right-5 flex gap-5"><button id="hero-prev" class="text-2xl text-white transition hover:scale-125" type="button" aria-label="Banner anterior"><i class="fi fi-rr-angle-left"></i></button><button id="hero-next" class="text-2xl text-white transition hover:scale-125" type="button" aria-label="Siguiente banner"><i class="fi fi-rr-angle-right"></i></button></div>
  </div>
</section>
<script lang="ts">
  const track = document.querySelector('#hero-track'); const slides = [...document.querySelectorAll('.hero-slide')]; let activeSlide = 0;
  function showSlide(index = 0) { activeSlide = (index + slides.length) % slides.length; if (track instanceof HTMLElement) track.style.transform = `translateX(-${activeSlide * 100}%)`; }
  document.querySelector('#hero-prev')?.addEventListener('click', () => showSlide(activeSlide - 1)); document.querySelector('#hero-next')?.addEventListener('click', () => showSlide(activeSlide + 1)); setInterval(() => showSlide(activeSlide + 1), 5000);
</script>
