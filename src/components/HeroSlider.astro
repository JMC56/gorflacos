---
const banners = [
  { image: '/assets/gorflacosbanner1.png', alt: 'Banner promocional Gorflacos 1' },
  { image: '/assets/gorflacosbanner2.png', alt: 'Banner promocional Gorflacos 2' },
  { image: '/assets/gorflacosbanner3.png', alt: 'Banner promocional Gorflacos 3' }
];
---
<section class="scroll-reveal mx-auto max-w-7xl px-5 pt-5 lg:px-8 lg:pt-8" aria-label="Promociones destacadas">
  <div id="hero-slider" class="overflow-hidden rounded-[2rem] shadow-candy">
    <div id="hero-track" class="flex transition-transform duration-700 ease-out">
    {banners.map((banner) => <article class="hero-slide min-w-full" data-slide>
      <img class="block aspect-[3/1] h-auto w-full object-cover" src={banner.image} alt={banner.alt} width="2160" height="720" />
    </article>)}
    </div>
  </div>
  <div class="mt-4 flex justify-center gap-3">
    <button id="hero-prev" class="grid size-11 place-items-center rounded-full bg-ink text-lg text-white transition hover:bg-candy" type="button" aria-label="Banner anterior" title="Banner anterior"><i class="fi fi-rr-angle-left"></i></button>
    <button id="hero-next" class="grid size-11 place-items-center rounded-full bg-ink text-lg text-white transition hover:bg-candy" type="button" aria-label="Siguiente banner" title="Siguiente banner"><i class="fi fi-rr-angle-right"></i></button>
  </div>
</section>
<script lang="ts">
  const track = document.querySelector('#hero-track'); const slides = [...document.querySelectorAll('.hero-slide')]; let activeSlide = 0;
  function showSlide(index = 0) { activeSlide = (index + slides.length) % slides.length; if (track instanceof HTMLElement) track.style.transform = `translateX(-${activeSlide * 100}%)`; }
  document.querySelector('#hero-prev')?.addEventListener('click', () => showSlide(activeSlide - 1)); document.querySelector('#hero-next')?.addEventListener('click', () => showSlide(activeSlide + 1)); setInterval(() => showSlide(activeSlide + 1), 5000);
</script>
