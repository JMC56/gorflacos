---
const collections = [
  { name: 'Shop All', image: '/assets/gor4.png', href: '/shop' },
  { name: 'Sweet & Sour', image: '/assets/gor5.png', href: '/shop?category=Sweet%20%26%20Sour' },
  { name: 'Best Sellers', image: '/assets/gor6.png', href: '/shop?category=Best%20Sellers' },
  { name: 'Chocolates', image: '/assets/gor7.png', href: '/shop?category=Chocolates' }
];
---
<section class="scroll-reveal mx-auto max-w-7xl px-5 py-16 lg:px-8 lg:py-24">
  <div class="mb-8 flex items-end justify-between"><div><p class="text-xs font-bold tracking-[0.22em] text-candy">CHOOSE YOUR JOY</p><h2 class="mt-2 font-display text-4xl font-bold tracking-[-0.07em] sm:text-5xl">Top selling collections</h2></div><div class="hidden gap-5 sm:flex"><button class="collection-prev text-2xl text-ink transition hover:scale-125" type="button" aria-label="Colección anterior"><i class="fi fi-rr-angle-left"></i></button><button class="collection-next text-2xl text-ink transition hover:scale-125" type="button" aria-label="Siguiente colección"><i class="fi fi-rr-angle-right"></i></button></div></div>
  <div id="collection-rail" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {collections.map((collection, index) => <a class={`scroll-reveal scroll-reveal-delay-${Math.min(index + 1, 3)} collection-card ${index > 1 ? 'hidden sm:block' : ''} group relative block aspect-square overflow-hidden rounded-2xl bg-ink/10 transition hover:-translate-y-1`} href={collection.href} aria-label={`Ver colección ${collection.name}`}><img class="absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-105" src={collection.image} alt={`${collection.name} colección`} width="1254" height="1254" loading="lazy" /><span class="absolute left-3 top-3 rounded-full bg-white/90 px-3 py-1.5 font-display text-sm font-bold text-ink shadow-sm">{collection.name}</span><i class="fi fi-rr-arrow-up-right absolute bottom-3 right-3 grid size-9 place-items-center rounded-full bg-white/90 text-base text-ink transition group-hover:rotate-45" aria-hidden="true"></i></a>)}
  </div>
</section>
<script>
  document.querySelector('.collection-next')?.addEventListener('click', () => document.querySelector('#collection-rail')?.scrollBy({ left: 280, behavior: 'smooth' }));
  document.querySelector('.collection-prev')?.addEventListener('click', () => document.querySelector('#collection-rail')?.scrollBy({ left: -280, behavior: 'smooth' }));
</script>
