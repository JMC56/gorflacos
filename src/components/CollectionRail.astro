---
const collections = [
  { name: 'Shop All', label: 'Todo lo dulce', image: '/assets/gorflacos4.png', color: 'bg-bubblegum', href: '/shop' },
  { name: 'Sweet & Sour', label: 'Ácido pero lindo', image: '/assets/gorflacos5.png', color: 'bg-aqua', href: '/shop?category=Sweet%20%26%20Sour' },
  { name: 'Best Sellers', label: 'Los más queridos', image: '/assets/gorflacos6.png', color: 'bg-lemon', href: '/shop?category=Best%20Sellers' },
  { name: 'Chocolates', label: 'Chocolate mood', image: '/assets/gorflacos7.png', color: 'bg-grape', href: '/shop?category=Chocolates' }
];
---
<section class="scroll-reveal mx-auto max-w-7xl px-5 py-16 lg:px-8 lg:py-24">
  <div class="mb-8 flex items-end justify-between"><div><p class="text-xs font-bold tracking-[0.22em] text-candy">CHOOSE YOUR JOY</p><h2 class="mt-2 font-display text-4xl font-bold tracking-[-0.07em] sm:text-5xl">Top selling collections</h2></div><div class="hidden gap-5 sm:flex"><button class="collection-prev text-2xl text-ink transition hover:scale-125" type="button" aria-label="Colección anterior"><i class="fi fi-rr-angle-left"></i></button><button class="collection-next text-2xl text-ink transition hover:scale-125" type="button" aria-label="Siguiente colección"><i class="fi fi-rr-angle-right"></i></button></div></div>
  <div id="collection-rail" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {collections.map((collection, index) => <a class={`scroll-reveal scroll-reveal-delay-${Math.min(index + 1, 3)} collection-card ${collection.color} ${index > 1 ? 'hidden sm:block' : ''} group relative min-h-52 overflow-hidden rounded-[2rem] p-4 transition hover:-translate-y-1`} href={collection.href}><div class="relative h-28 overflow-hidden rounded-[1.4rem] bg-white/40"><img class="h-full w-full object-cover transition duration-500 group-hover:scale-105" src={collection.image} alt={`${collection.name} colección`} width="800" height="800" /><span class="absolute left-3 top-3 text-xs font-bold tracking-[0.18em] text-ink/60">0{index + 1}</span></div><h3 class="mt-5 px-2 font-display text-2xl font-bold tracking-[-0.05em]">{collection.name}</h3><p class="mt-1 px-2 text-sm text-ink/65">{collection.label}</p><i class="fi fi-rr-arrow-up-right absolute right-6 top-6 text-xl transition group-hover:rotate-45"></i></a>)}
  </div>
</section>
<script>
  document.querySelector('.collection-next')?.addEventListener('click', () => document.querySelector('#collection-rail')?.scrollBy({ left: 280, behavior: 'smooth' }));
  document.querySelector('.collection-prev')?.addEventListener('click', () => document.querySelector('#collection-rail')?.scrollBy({ left: -280, behavior: 'smooth' }));
</script>
