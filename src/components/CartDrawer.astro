---
---

<div id="cart-backdrop" class="fixed inset-0 z-40 hidden bg-ink/40 backdrop-blur-sm"></div>
<aside id="cart-drawer" class="fixed right-0 top-0 z-50 flex h-full w-full max-w-md translate-x-full flex-col bg-cream p-6 shadow-2xl transition-transform duration-300" aria-label="Carrito de compras" aria-hidden="true">
  <div class="flex items-center justify-between border-b border-ink/10 pb-5">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-tomato">Tu selección</p>
      <h2 class="mt-1 font-display text-3xl font-bold tracking-[-0.05em]">Carrito</h2>
    </div>
    <button id="close-cart" class="grid size-10 place-items-center rounded-full border border-ink/15 text-xl transition hover:bg-ink hover:text-cream" type="button" aria-label="Cerrar carrito">×</button>
  </div>
  <div id="cart-items" class="flex-1 overflow-y-auto py-6">
    <p class="text-sm text-ink/60">Tu carrito está esperando un antojo.</p>
  </div>
  <div class="border-t border-ink/10 pt-5">
    <div class="flex items-center justify-between font-display text-xl font-bold">
      <span>Total</span>
      <span id="cart-total">C$0</span>
    </div>
    <button id="checkout" class="mt-5 w-full rounded-full bg-tomato px-5 py-4 font-bold text-white transition hover:bg-ink" type="button">Continuar pedido</button>
  </div>
</aside>